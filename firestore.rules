rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Allow read & write for users collection, but restrict field modifications
    match /users/{userId} {
      allow read: if true;
      // Users can only write their own document and specific fields
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Allow read & write for posts collection
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Allow read & write for notifications collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Allow read & write for system_config collection
    match /system_config/{docId} {
      allow read, write: if true;
    }
  }
}
